FROM node:22-slim

WORKDIR /app

# System deps for native modules (pg) + curl for healthchecks/waits
RUN apt-get update && apt-get install -y python3 make g++ curl && rm -rf /var/lib/apt/lists/*

# pnpm is pinned to the EXACT version in the root package.json's `packageManager` field: pnpm
# refuses to run a project pinned to a different version (package-manager-strict, on by
# default), so bumping that field means bumping it here and in Dockerfile.controlplane.
RUN npm install -g pnpm@11.22.0 --quiet

# Manifests and the lockfile first, to keep the layer cache tight. The workspace root manifest is
# needed for pnpm to recognise the monorepo layout.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
# Every workspace manifest, not just the ones this image builds: --frozen-lockfile validates the
# lockfile against ALL importers, so a missing one fails the install. Keep in step with
# pnpm-workspace.yaml's globs (packages/*, docs-site) — Docker's COPY cannot glob these into place.
COPY docs-site/package.json                    docs-site/
COPY packages/controlplane/package.json        packages/controlplane/
COPY packages/policy/package.json              packages/policy/
COPY packages/sdk/package.json                 packages/sdk/
COPY packages/shared/package.json              packages/shared/
COPY packages/simulator/package.json           packages/simulator/
COPY packages/trust/package.json               packages/trust/
COPY packages/webhook-dispatcher/package.json  packages/webhook-dispatcher/

# Install only the packages needed for policy + shared + webhook-dispatcher
# --frozen-lockfile is what makes the image reproduce the host: without it pnpm re-resolves every
# range and the image can end up on different versions than the build that passed locally.
RUN pnpm install --frozen-lockfile \
                 --filter @vaultysclaw/policy \
                 --filter @vaultysclaw/shared \
                 --filter @vaultysclaw/webhook-dispatcher

# Copy source (scripts/ is needed by the policy + shared builds for fix-esm-extensions)
COPY scripts/                       scripts/
COPY packages/policy/               packages/policy/
COPY packages/shared/               packages/shared/
COPY packages/webhook-dispatcher/   packages/webhook-dispatcher/

# The dispatcher shares the control plane's Prisma schema. Copy it INTO the package
# so Prisma resolves @prisma/client from packages/webhook-dispatcher/node_modules,
# then generate only the `client` generator.
COPY packages/controlplane/prisma/schema.prisma packages/webhook-dispatcher/prisma/schema.prisma
RUN pnpm --filter @vaultysclaw/webhook-dispatcher exec prisma generate \
      --schema=/app/packages/webhook-dispatcher/prisma/schema.prisma \
      --generator client

# Build workspace deps (policy before shared) so the dispatcher can import their dist
RUN pnpm --filter @vaultysclaw/policy build \
 && pnpm --filter @vaultysclaw/shared build

WORKDIR /app/packages/webhook-dispatcher

# TCP probe: wait for postgres to be reachable before starting.
COPY docker/wait-for-db.sh /usr/local/bin/wait-for-db
RUN chmod +x /usr/local/bin/wait-for-db

CMD ["wait-for-db", "sh", "-c", "node --import tsx src/index.ts"]
