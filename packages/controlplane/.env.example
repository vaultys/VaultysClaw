# PostgreSQL connection (see docker/docker-compose.yml for the shared dev stack)
DATABASE_URL=postgresql://vaultys:vaultys_dev_secret@localhost:5432/vaultysclaw

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-generate-a-real-secret

# Ports — different from packages/control-plane's (3000/8080) so both can run side by side.
CONTROLPLANE_PORT=3001
CONTROLPLANE_WS_PORT=8081

# Wallet app URL used to build the QR-login deep link.
NEXT_PUBLIC_WALLET_URL=https://wallet.vaultys.net
