{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      // ^build: policy/shared/trust are consumed as built `dist`, so a package cannot be
      // type-checked before its workspace dependencies are built. Locally dist already exists
      // from a previous build, which is why a fresh checkout (CI) was the only place this failed.
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      // ^build for the same reason as type-check: vitest resolves @vaultysclaw/* through their
      // package.json entry points, which point into dist.
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
