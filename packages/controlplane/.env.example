# PostgreSQL, Redis, and Apprise: `pnpm controlplane:docker:up` (from repo root) starts all
# three via docker/docker-compose.controlplane.yml — a dedicated dev stack for this package, on
# ports that never collide with packages/control-plane's own docker/docker-compose.yml. Or just
# `pnpm controlplane:dev`, which starts the stack and this package's dev server in one step.
DATABASE_URL=postgresql://vaultys:vaultys_dev_secret@localhost:5433/vaultysclaw

# Redis — the BullMQ queue behind Webhooks/Notification Channels (lib/webhook-queue.ts). Optional:
# unset means those features silently no-op rather than breaking anything else.
REDIS_URL=redis://localhost:6381

# Apprise API — backs Notification Channels (docs/REBUILD_ARCHITECTURE.md §5, lib/apprise.ts).
# Optional: unset means that feature is off (can't push/notify/delete Apprise config); Webhooks
# are unaffected either way.
APPRISE_API_URL=http://localhost:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-generate-a-real-secret

# Ports — different from packages/control-plane's (3000/8080) so both can run side by side.
CONTROLPLANE_PORT=3001
CONTROLPLANE_WS_PORT=8081

# Wallet app URL used to build the QR-login deep link.
NEXT_PUBLIC_WALLET_URL=https://wallet.vaultys.net
