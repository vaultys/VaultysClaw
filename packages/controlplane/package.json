{
  "name": "@vaultysclaw/controlplane",
  "version": "0.0.1",
  "description": "VaultysClaw rebuilt control plane — administration-first, VaultysId certificate ledger at the core. See docs/REBUILD_ARCHITECTURE.md.",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "dev": "tsx watch --exclude '.next/**' server.ts",
    "build": "tsc && next build",
    "start": "node dist/server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@roamhq/wrtc": "^0.10.0",
    "@vaultys/channel-browser": "^2.4.2",
    "@vaultys/channel-peerjs": "^2.4.3",
    "@vaultys/id": "3.0.0-beta9.3",
    "@vaultysclaw/policy": "workspace:*",
    "@vaultysclaw/shared": "workspace:*",
    "@vaultysclaw/trust": "workspace:*",
    "bullmq": "^5.80.0",
    "cmdk": "^1.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.14.0",
    "next": "^16.3",
    "next-auth": "^4.24.14",
    "ol": "^10.9.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19",
    "ws": "^8.20.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.14",
    "prisma": "^7",
    "tsx": "^4.21.0",
    "typescript": "^7",
    "vitest": "^2.1.9"
  }
}