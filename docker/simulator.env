# The fleet-simulator demo environment — a control plane and database that exist only to be
# hammered, kept entirely separate from your working dev stack.
#
# This file is the single source of truth for that environment's coordinates: the compose file
# reads it (`--env-file`), and every `pnpm simulator:*` script sources it. Committed on purpose —
# nothing here is secret, and a demo stack whose ports live in three places drifts apart the first
# time someone changes one.
#
# Ports are deliberately one above the dev stack's (5434 vs 5433, 3003/8083 vs 3001/8081) so both
# can run at the same time. That is the point: a 7,000-Actor run should never be able to touch the
# database holding your real Actors.

# ── Database (docker/docker-compose.simulator.yml) ──
PG_PORT=5434
PG_PASSWORD=vaultys_demo
DATABASE_URL=postgresql://vaultys:vaultys_demo@localhost:5434/vaultysclaw

# ── Control plane ──
# Production mode, and not only for speed: Next 16 refuses to start a second *dev* server for the
# same project directory (a lockfile under .next/dev, not a port clash), so a demo control plane
# could never run alongside your `pnpm controlplane:dev`. Production mode takes no such lock — and
# it also stops the demo's own Next compilation from competing for CPU with the thing being
# measured. Requires a build: `pnpm simulator:build`, which `simulator:up` runs for you.
NODE_ENV=production
CONTROLPLANE_PORT=3003
CONTROLPLANE_WS_PORT=8083
NEXTAUTH_URL=http://localhost:3003
# Demo-only. A throwaway value is correct here: this stack is reset routinely and holds no real
# session worth protecting. Never copy it into a real .env.
NEXTAUTH_SECRET=simulator-demo-not-a-real-secret

# Where the simulator points. Kept next to the port it must agree with.
CONTROLPLANE_WS_URL=ws://localhost:8083

# This stack runs a *production build* (see NODE_ENV above), which disables the
# "connect without the app" login — and the demo database has no admin, so without this you could
# not open the console to look at the fleet you just simulated. Opt in explicitly.
#
# Safe here and nowhere else: this control plane is disposable, listens on localhost, and holds
# nothing real. It is inlined at build time, so a production image built without it cannot have the
# path enabled by setting an environment variable later.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=1

# ── Deliberately unset ──
# REDIS_URL / APPRISE_API_URL: with no Redis configured, `enqueueWebhook` is a no-op and the whole
# webhook/notification path is skipped. A 7,000-Actor ramp would otherwise enqueue tens of
# thousands of jobs nothing is consuming — pure noise for a demo about identity and certificates.
# The audit log still records everything, since that write is inline and not queue-backed.

# Sized for the ramp rather than for an idle console: the handshake path puts several queries behind
# every connection. See packages/controlplane/CLAUDE.md's Scale section.
DATABASE_POOL_MAX=60
