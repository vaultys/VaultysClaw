{
  "name": "@vaultysclaw/simulator",
  "version": "0.0.1",
  "description": "Fleet simulator — drives thousands of real-VaultysId Actors against the control plane and exercises the full lifecycle",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --conditions=tsx --import tsx src/index.ts",
    "start": "node --conditions=tsx --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vaultys/id": "3.0.0-beta6",
    "@vaultysclaw/policy": "workspace:*",
    "@vaultysclaw/sdk": "workspace:*",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
