# The demo-video environment (packages/videos) — a control plane, a database and a simulated fleet
# that exist only to be filmed, separate from both your dev stack and the simulator's demo stack.
#
# Same shape as docker/simulator.env (it reuses docker/docker-compose.simulator.yml under its own
# compose project, `vaultysclaw-video`, so its own volume), on ports of its own: a recording must
# not depend on — or disturb — a simulator demo or a dev server running at the same time, and
# VaultysHub's video labs already hold 3003/8083 on a machine that records both products.
# Committed on purpose, like simulator.env: nothing here is secret.

# ── Database ──
PG_PORT=5436
PG_PASSWORD=vaultys_video
DATABASE_URL=postgresql://vaultys:vaultys_video@localhost:5436/vaultysclaw

# ── Control plane ── production build, for the reasons given in docker/simulator.env.
NODE_ENV=production
CONTROLPLANE_PORT=3013
CONTROLPLANE_WS_PORT=8093
NEXTAUTH_URL=http://localhost:3013
# Demo-only throwaway. Never copy it into a real .env.
NEXTAUTH_SECRET=video-demo-not-a-real-secret
CONTROLPLANE_WS_URL=ws://localhost:8093

# The filmed admin signs in with a VaultysID held by the browser (`pnpm simulator admin` mints it).
# Inlined at build time — see docker/simulator.env.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=1

# No Redis / Apprise: nothing consumes webhooks while filming. The audit log is unaffected.
DATABASE_POOL_MAX=60
