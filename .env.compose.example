# VaultysClaw deployed stack (docker/docker-compose.yml) — environment overrides.
#
# Two ways to use it:
#   cp .env.compose.example docker/.env    # picked up automatically by `cd docker && docker compose up`
#                                          # — this is what the deploy workflow relies on
#   cp .env.compose.example .env.compose   # then: docker compose -f docker/docker-compose.yml \
#                                          #         --env-file .env.compose up --build
#
# Every variable has a default that works for local dev. Change the two marked REQUIRED before
# exposing the stack to a network.

# ── PostgreSQL — the certificate ledger ──────────────────────────────────────
# REQUIRED in any real deployment.
PG_PASSWORD=change_me_strong_password
# Host-side port only; in-network clients always use postgres:5432.
PG_PORT=5432

# ── Redis — the BullMQ webhook queue ─────────────────────────────────────────
# REDIS_URL is the in-network URL (compose DNS name "redis"). REDIS_PORT is only the host-side
# port for debugging; 6380 avoids clashing with a local Redis already bound to 6379.
REDIS_URL=redis://redis:6379
REDIS_PORT=6380

# Must match the control plane producer's BullMQ prefix, or the dispatcher consumes nothing.
BULLMQ_PREFIX=vaultysclaw-controlplane
# Per-endpoint webhook delivery timeout, in ms.
WEBHOOK_TIMEOUT_MS=10000

# ── Apprise — backs Notification Channels ────────────────────────────────────
# Unset this to turn Notification Channels off entirely; webhook delivery is unaffected.
APPRISE_API_URL=http://apprise:8000

# ── Control plane ────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_with_openssl_rand_base64_32
# Browser-facing base URL. Also what adminUrl deep links in webhooks/notifications are built
# from, unless APP_URL is set — APP_URL wins.
NEXTAUTH_URL=http://localhost:3000
# APP_URL=https://console.example.com

# Host-side ports. The container always listens on 3000 (HTTP) and 8080 (WebSocket).
CONTROLPLANE_PORT=3000
CONTROLPLANE_WS_PORT=8080

# Dev-only: enables the "connect without the app" browser login option. Leave false in production.
VC_DEV_LOGIN=false

# ── Model Registry (optional) ────────────────────────────────────────────────
# Deployment-time FALLBACK only: the Setting rows an admin edits under Integrations → Models win,
# and store the master key encrypted. No LiteLLM runs in this stack — point these at an external
# proxy if you have one.
# LITELLM_BASE_URL=http://litellm.internal:4000
# LITELLM_MASTER_KEY=sk-your-master-key-here
